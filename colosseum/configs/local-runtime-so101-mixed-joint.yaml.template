# Machine config for the SO101 Open track: five VLA workers plus three LLM agents.
# LLMs drive the arm through SO101 joint positions (control_mode: joint_pos).
# Generate the real file with (see colosseum/README.md, section 6):
#   sed -e "s#__ROOT__#$PWD#g" colosseum/configs/local-runtime-so101-mixed-joint.yaml.template \
#     > colosseum-policy-server/configs/local-runtime-so101-mixed-joint.yaml
# then replace the J1..J5 joint limits with the values from colosseum/tools/joint_limits.py.
# name / url / revision / action contract / max_horizon must equal the Router registration.
host: 127.0.0.1
port: 8000
log_dir: __ROOT__/outputs/colosseum/policy-logs
start_timeout_seconds: 600
backend:
  name: auto
  options:
    external_sensor: head_image
    wrist_sensor: left_image
    http_timeout_seconds: 60
    llm:
      robot_type: so101
      sensors: [head_image, left_image]
      effort: medium
      # Claude Code CLI bundled in claude-agent-sdk (README section 3.7). Log in once with
      # "<this path> auth login" as the user that runs the Policy Server.
      claude_command: __ROOT__/envs/claude-cli/claude_agent_sdk/_bundled/claude
      control_mode: joint_pos
      # Same limits as adapter_config.joint_low/joint_high in the Client config.
      joint_low: [J1, J2, J3, J4, J5]
      joint_high: [J1, J2, J3, J4, J5]
      joint_max_step: [1.0, 1.0, 0.9, 1.0, 1.8]
      gripper_open_value: 1
      robot_notes: >-
        SO-101 follower with five calibrated joint angles in degrees and one
        gripper opening from 0 (closed) to 100 (open). Positive joint angles
        follow the LeRobot calibrated motor axes. head_image is the fixed front
        view and left_image is the wrist camera. Read measured joint positions
        before each move; camera images do not provide calibrated object poses.
      images: always
models:
  # ---------------- VLA workers (one loaded at a time on the local GPU) ----------------
  - name: molmoact2-so101
    url: https://huggingface.co/allenai/MolmoAct2-SO100_101
    revision: "152569fe57914d97be91055800035f54e250d009"
    action_space: joint_position
    action_dim: 6
    control_hz: 30
    max_horizon: 30
    endpoint: http://127.0.0.1:9201
    backend_options: {robot_type: so101, adapter: molmoact2_so101, num_steps: 10}
    launcher: [__ROOT__/envs/.venv/bin/python, -m, colosseum_policy_server.model_service,
               molmoact2, --robot-type, so101, --checkpoint, __ROOT__/checkpoints/MolmoAct2-SO100_101,
               --device, "cuda:0", --dtype, bfloat16, --port, "9201"]
  - name: pi05-so101
    url: https://huggingface.co/hqfang/pi05-so100_101
    revision: "d3204e03ae84d232e2493a933fd460515904eb58"
    action_space: joint_position
    action_dim: 6
    control_hz: 30
    max_horizon: 50
    endpoint: http://127.0.0.1:9212
    backend_options: {robot_type: so101, adapter: pi05_so101, num_steps: 10}
    launcher: [__ROOT__/envs/pi05_so101/.venv/bin/python, -m, colosseum_policy_server.model_service,
               pi05_lerobot, --robot-type, so101, --checkpoint, __ROOT__/checkpoints/pi05-so100_101,
               --device, cuda, --port, "9212"]
  - name: g05-so101
    url: https://huggingface.co/OpenGalaxea/G05
    revision: "e312be81e90c56a55bcb26b57429bd39a335b449"
    action_space: joint_position
    action_dim: 6
    control_hz: 30
    max_horizon: 30
    endpoint: ws://127.0.0.1:9204
    backend_options: {robot_type: so101, adapter: g05_so101}
    launcher: [__ROOT__/vendor/GalaxeaVLA/.venv/bin/python, -m, colosseum_policy_server.model_service,
               g05, --robot-type, so101, --source-root, __ROOT__/vendor/GalaxeaVLA,
               --checkpoint, __ROOT__/checkpoints/G05/g05-so101/checkpoints/model_state_dict.pt,
               --device, cuda, --action-steps, "30", --port, "9204"]
  - name: groot-n17-so101
    url: https://huggingface.co/hqfang/groot-so100_101
    revision: "f5e17af8948a647e4c23186a27927bf73d6d784e"
    action_space: joint_position
    action_dim: 6
    control_hz: 30
    max_horizon: 40
    endpoint: http://127.0.0.1:9217
    backend_options: {robot_type: so101, adapter: groot_so101}
    launcher: [__ROOT__/envs/.venv/bin/python, -m, colosseum_policy_server.model_service,
               groot_n17, --robot-type, so101, --checkpoint, __ROOT__/checkpoints/groot-so100_101,
               --base-model, __ROOT__/checkpoints/GR00T-N1.7-3B, --device, cuda, --port, "9217"]
  # LingBot VLA v2 fine-tuned on the MolmoAct2 SO100/101 data (not a Molmo model).
  # Own torch 2.8 env; flash-attn is not installed, so attention uses SDPA. The bundled
  # Python headers let Triton build its CUDA helper without python3.12-dev.
  - name: lingbot-molmoact2-so101
    url: https://huggingface.co/RoboColosseum/LingBot-MolmoAct2-So101
    revision: "d360710b21beec2804e42ac2d6035022c2a4c1a8"
    action_space: joint_position
    action_dim: 6
    control_hz: 30
    max_horizon: 50
    endpoint: http://127.0.0.1:9218
    backend_options: {robot_type: so101, adapter: lingbot_so101}
    launcher: [/usr/bin/env, LINGBOT_ATTN_IMPL=sdpa, PYTHONNOUSERSITE=1,
               "C_INCLUDE_PATH=__ROOT__/envs/pyheaders/usr/include:__ROOT__/envs/pyheaders/usr/include/python3.12:__ROOT__/envs/pyheaders/usr/include/x86_64-linux-gnu/python3.12",
               __ROOT__/envs/.venv-lingbot/bin/python, -m, colosseum_policy_server.model_service,
               lingbot_v2, --robot-type, so101, --checkpoint, __ROOT__/checkpoints/LingBot-MolmoAct2-So101,
               --source-root, __ROOT__/vendor/lingbot-vla-v2,
               --processor, __ROOT__/checkpoints/Qwen3-VL-4B-Instruct, --device, cuda, --port, "9218"]
  # ---------------- LLM agents (in-process, no GPU) ----------------
  # url/revision are the Router identities (relay URL + rig suffix); inference goes straight
  # to api_base_url, the provider's official API. Keys come from the Client terminal
  # (OPENAI_API_KEY / XAI_API_KEY); Claude uses the Claude Code account login above.
  - name: grok-4.7
    model_type: llm
    url: https://api.yhlxj.ai/v1
    revision: "4.7"
    action_space: joint_position
    action_dim: 6
    control_hz: 10
    max_horizon: 150
    endpoint: inprocess://inspect-agent
    backend_options: {robot_type: so101, api_model: grok-4.7, api_base_url: https://api.x.ai/v1}
  - name: claude-opus-5-5
    model_type: llm
    url: https://api.yhlxj.ai
    revision: rig-v1
    action_space: joint_position
    action_dim: 6
    control_hz: 30
    max_horizon: 150
    endpoint: inprocess://inspect-agent
    backend_options: {robot_type: so101, api_model: claude-opus-5-5, api_base_url: https://api.anthropic.com/v1}
  - name: gpt-6-astra
    model_type: llm
    url: https://api.yhlxj.ai/v1
    revision: rig-v1
    action_space: joint_position
    action_dim: 6
    control_hz: 10
    max_horizon: 150
    endpoint: inprocess://inspect-agent
    backend_options: {robot_type: so101, api_model: gpt-6-astra, api_base_url: https://api.openai.com/v1}
