# Client config for the SO101 Open track with the mixed VLA/LLM Policy Server
# (local-runtime-so101-mixed-joint.yaml). LLMs use SO-101 joint control.
# Copy to colosseum-client/configs/robot.so101.joint.yaml (git-ignored there), fill in the
# UPPER_CASE placeholders, then: chmod 600 colosseum-client/configs/robot.so101.joint.yaml
router_url: wss://191.222.219.43
token: CLIENT_TOKEN                 # clt_..., from the Colosseum admin
institution: INSTITUTION            # exactly as bound to the token, e.g. NUS
robot_type: so101
track: 1                            # 1 = Open, 2 = Fine-tuning
# Open Track: leave scene/instruction empty to be prompted at start-up.
scene: ""
evaluator: ""
policy_server_url: ws://127.0.0.1:8000
llm_control_mode: joint_pos
# API keys are read from the environment of the terminal that starts colosseum-robot.
# An unset variable does not enable that provider.
llm_api_keys:
  openai: env:OPENAI_API_KEY
  xai: env:XAI_API_KEY
# Claude runs through a Claude Code account logged in on the Policy Server host
# (README section 3.7). Do not also set an Anthropic API key.
llm_account_logins:
  anthropic: claude-code
control_hz: 30                      # the Router registers the SO101 VLA models at 30 Hz
# LLM policies take 15-30 s per plan with images; the 30 s default aborts trials.
# Keep this above the Policy Server's http_timeout_seconds (60).
deadline_ms: 180000
image_width: 640
image_height: 480
cameras:
  head_image: "REALSENSE_SERIAL"    # top/external camera; numeric serial => RealSense
  # The Router only knows head_image/left_image/right_image; the second camera takes left_image.
  left_image: /dev/v4l/by-id/WRIST_CAMERA-video-index0   # wrist camera; path/index => OpenCV
adapter_config:
  max_relative_target: null
  port: /dev/serial/by-id/FOLLOWER_ARM_PORT
  robot_id: follower_arm            # LeRobot calibration id (file name under so_follower/)
  # From: python3 colosseum/tools/joint_limits.py <calibration json>
  # Also copy them into backend.options.llm.joint_low/joint_high of the Policy Server config.
  joint_low: [J1, J2, J3, J4, J5]
  joint_high: [J1, J2, J3, J4, J5]
  # G05 starts from its upstream home pose (training-data mean, arm raised), as its official
  # SO100 client does. The other models start from wherever the arm is placed.
  start_poses:
    g05-so101-v1: [3.1, -34.3, 31.5, 55.9, -12.3, 13.4]
  return_to_start: true
recording: true
skip_upload: false
max_trial_steps: 800
test: false
